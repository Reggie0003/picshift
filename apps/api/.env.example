# ============================================================================
# Pic Shift API — environment variables
# Copy to .env (or .env.production on the VMware host) and fill in real values.
# NEVER commit a real .env file. All secrets must live in your secrets manager.
# ============================================================================

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000

# Database (self-hosted Postgres on VMware)
# Required Postgres extensions: pgcrypto, pgvector, citext
DATABASE_URL=postgresql://picshift:devpassword@localhost:5432/picshift?schema=public&sslmode=disable

# Redis (sessions, rate limiting, MFA challenge cache, bull queues)
REDIS_URL=redis://localhost:6379

# JWT signing (32+ chars; rotate quarterly)
JWT_ACCESS_SECRET=replace-me-with-64-char-random-secret-in-prod
JWT_REFRESH_SECRET=replace-me-with-different-64-char-secret
JWT_ACCESS_TTL=900            # 15 minutes
JWT_REFRESH_TTL=2592000       # 30 days

# Field-level encryption (envelope encryption key — KEK)
# Generate via: openssl rand -base64 32
ENCRYPTION_KEY=replace-me-with-base64-32-byte-key

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# Account lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900     # 15 minutes

# S3 / object storage (AWS S3 in prod, MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_DOCUMENTS=picshift-documents-dev
S3_BUCKET_BACKUPS=picshift-backups-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Email (AWS SES recommended; SendGrid as alternative)
EMAIL_PROVIDER=ses             # ses | sendgrid | smtp | console
EMAIL_FROM="Pic Shift <no-reply@picshift.app>"
SES_REGION=eu-west-1
# SENDGRID_API_KEY=

# SMS (Hubtel for Ghana; Twilio for international)
SMS_PROVIDER=hubtel            # hubtel | twilio | console
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=PicShift

# AI providers (Phase 2 — leave blank to disable)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Payment providers (Phase 3 — leave blank to disable)
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_TARGET_ENV=sandbox

VODAFONE_CASH_MERCHANT_ID=
VODAFONE_CASH_API_KEY=

# Sentry / error tracking (optional)
SENTRY_DSN=

# Default org timezone (Africa/Accra)
DEFAULT_TIMEZONE=Africa/Accra
DEFAULT_CURRENCY=GHS
